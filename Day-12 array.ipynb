   "source": [
    "# Remove a specific element without using the remove() method\n",
    "arr = [1, 2, 3, 4, 5]\n",
    "remove = 3\n",
    "if remove in arr:\n",
    "    arr = [x for x in arr if x != remove]\n",
    "print(arr)"
   ]
