    "# Find the smallest and its index\n",
    "arr = [5, 2, 9, 1, 5, 6]\n",
    "for i in range(len(arr)):\n",
    "    if arr[i] == min(arr):\n",
    "        print(f\"The smallest element is {arr[i]} at index {i}\")\n",
    "        break\n",
    "    "
